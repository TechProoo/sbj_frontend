VITE_API_URL=http://localhost:4000/api
VITE_VAPID_PUBLIC_KEY=

# The site's public origin — scheme, no trailing slash. Drives every canonical
# URL, og:url, the sitemap and the JSON-LD listing. Must be the real domain in
# production (set in netlify.toml); http://localhost:5173 for local work.
VITE_SITE_URL=http://localhost:5173
